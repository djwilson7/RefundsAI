# Backend database connection used by docker compose.
# Use the Supabase PostgreSQL connection string from Project Settings > Database.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# OpenAI model configuration used by the FastAPI chat and model-health endpoints.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Used only by explicitly integrated frontend builds.
REFUNDS_AI_API_BASE_URL=http://localhost:8000

# Frontend-only demo by default. Set false before build/startup for integrated mode.
REFUNDS_AI_DEMO_MODE=true

# Optional host port for docker-compose.dev.yml.
REFUNDS_AI_WEB_PORT=3000
