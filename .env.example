# Backend database connection used by docker compose.
# Use the Supabase PostgreSQL connection string from Project Settings > Database.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Server-side Next.js calls to the FastAPI backend.
REFUNDS_AI_API_BASE_URL=http://localhost:8000
